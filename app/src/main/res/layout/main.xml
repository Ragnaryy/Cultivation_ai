<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/background_gradient"
    android:padding="10dp">

    <!-- Левая панель - статистика -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:background="#2D1B2D"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Небесный Путь"
                android:textColor="#FFD700"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_marginBottom="10dp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/statsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E8DAB2"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.2"
                android:text="Загрузка дао..."/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#4A4A8F"
                android:layout_marginVertical="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="События Мира"
                android:textColor="#FFD700"
                android:textSize="16sp"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:id="@+id/worldLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B8B8D0"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.1"
                android:text="Мир только рождается..."/>

        </LinearLayout>

    </ScrollView>

    <!-- Центр - игровое поле -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:layout_marginHorizontal="5dp"
        android:background="#1A1A2E"
        android:id="@+id/gameContainer"/>

    <!-- Правая панель - управление -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#2D1B2D"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Воля Бессмертного"
            android:textColor="#FFD700"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginBottom="15dp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/toggleAIbtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌀 Авто-Культивация"
            android:background="@drawable/button_cultivation"
            android:textColor="#E8DAB2"
            android:layout_marginBottom="8dp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/cultivateBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌌 Циркуляция Ци"
            android:background="@drawable/button_cultivation"
            android:textColor="#E8DAB2"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/attackBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ Небесная Кара"
            android:background="@drawable/button_cultivation"
            android:textColor="#E8DAB2"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/gatherBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌿 Сбор Дао"
            android:background="@drawable/button_cultivation"
            android:textColor="#E8DAB2"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/meditateBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💭 Познание Пути"
            android:background="@drawable/button_cultivation"
            android:textColor="#E8DAB2"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Пределы Мира"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:id="@+id/worldInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B8B8D0"
            android:textSize="12sp"
            android:text="Эра: 1\nЦикл: 1"/>

    </LinearLayout>

</LinearLayout>
